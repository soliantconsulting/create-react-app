<!--
    Cognito uses this one template for every code it emails: forgotten passwords, password resets
    started by an administrator, and confirming a changed email address. Cognito replaces {####}.
-->
<tr>
    <td style="padding: 32px 32px 0;">
        <h1 style="margin: 0 0 16px; font-size: 22px; font-weight: 500;">
            Your verification code
        </h1>
        <p style="margin: 0 0 24px; font-size: 15px; line-height: 1.5;">
            Enter this code to reset your {{project.title | escape}} password or to confirm your
            email address.
        </p>
    </td>
</tr>
<tr>
    <td style="padding: 0 32px;">
        <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0"
            style="background-color: #f4f5f7; border-radius: 6px;">
            <tr>
                <td align="center"
                    style="padding: 20px; font-family: Consolas, Menlo, monospace; font-size: 28px; font-weight: 600; letter-spacing: 6px;">
                    {####}
                </td>
            </tr>
        </table>
    </td>
</tr>
<tr>
    <td style="padding: 24px 32px 32px; font-size: 13px; line-height: 1.5; color: #6b7280;">
        If you did not expect this email, you can ignore it or contact your administrator.
    </td>
</tr>
