import { execSync } from "node:child_process";
import path from "node:path";
import { fileURLToPath } from "node:url";
import {
    AssetHashType,
    CfnOutput,
    DockerImage,
    RemovalPolicy,
    Stack,
    type StackProps,
} from "aws-cdk-lib";
import { Certificate } from "aws-cdk-lib/aws-certificatemanager";
import {
    Distribution,
    HttpVersion,
    ResponseHeadersPolicy,
    ViewerProtocolPolicy,
} from "aws-cdk-lib/aws-cloudfront";
import { S3BucketOrigin } from "aws-cdk-lib/aws-cloudfront-origins";
import { LogGroup, RetentionDays } from "aws-cdk-lib/aws-logs";
import { BlockPublicAccess, Bucket } from "aws-cdk-lib/aws-s3";
import { BucketDeployment, CacheControl, Source } from "aws-cdk-lib/aws-s3-deployment";
import type { Construct } from "constructs";
import { copySync } from "fs-extra/esm";
{%- if features contains "cognito" %}
import { CognitoAuth, type CognitoAuthProps } from "./cognito-auth.js";
{%- endif %}

type BuildEnv = {
    VITE_APP_API_ENDPOINT: string;
    {%- if features contains "auth0" %}
    VITE_APP_AUTH0_DOMAIN: string;
    VITE_APP_AUTH0_CLIENT_ID: string;
    VITE_APP_AUTH0_AUDIENCE: string;
    {%- endif %}
    {%- if sentry %}
    VITE_APP_SENTRY_DSN: string;
    VITE_APP_SENTRY_ENVIRONMENT: string;
    VITE_APP_SENTRY_TRACES_SAMPLE_RATE: string;
    {%- endif %}
};

type AppStackProps = StackProps & {
    certificateArn: string;
    domainName: string;
    buildEnv: BuildEnv;
    {%- if features contains "cognito" %}
    cognito: Omit<CognitoAuthProps, "appDomainName">;
    {%- endif %}
};

export class AppStack extends Stack {
    public constructor(scope: Construct, id: string, props: AppStackProps) {
        super(scope, id, props);

        const websiteBucket = new Bucket(this, "WebsiteBucket", {
            autoDeleteObjects: true,
            blockPublicAccess: BlockPublicAccess.BLOCK_ALL,
            removalPolicy: RemovalPolicy.DESTROY,
        });

        const certificate = Certificate.fromCertificateArn(
            this,
            "Certificate",
            props.certificateArn,
        );

        const distribution = new Distribution(this, "Distribution", {
            certificate,
            domainNames: [props.domainName],
            defaultBehavior: {
                origin: S3BucketOrigin.withOriginAccessControl(websiteBucket),
                responseHeadersPolicy: ResponseHeadersPolicy.SECURITY_HEADERS,
                viewerProtocolPolicy: ViewerProtocolPolicy.REDIRECT_TO_HTTPS,
            },
            defaultRootObject: "index.html",
            httpVersion: HttpVersion.HTTP2_AND_3,
            errorResponses: [
                {
                    httpStatus: 404,
                    responseHttpStatus: 200,
                    responsePagePath: "/index.html",
                },
                {
                    httpStatus: 403,
                    responseHttpStatus: 200,
                    responsePagePath: "/index.html",
                },
            ],
        });

        new CfnOutput(this, "DistributionDomainName", { value: distribution.domainName });
        {%- if features contains "cognito" %}

        const cognitoAuth = new CognitoAuth(this, "CognitoAuth", {
            ...props.cognito,
            appDomainName: props.domainName,
        });

        // Values for the VITE_APP_COGNITO_* variables in .env for local development.
        new CfnOutput(this, "CognitoRegion", { value: cognitoAuth.runtimeConfig.region });
        new CfnOutput(this, "CognitoUserPoolId", { value: cognitoAuth.runtimeConfig.userPoolId });
        new CfnOutput(this, "CognitoClientId", { value: cognitoAuth.runtimeConfig.clientId });
        new CfnOutput(this, "CognitoDomain", { value: cognitoAuth.runtimeConfig.domain });
        {%- if features contains "cognito-admin" %}
        new CfnOutput(this, "CognitoIdentityPoolId", {
            value: cognitoAuth.runtimeConfig.identityPoolId,
        });
        {%- endif %}
        {%- endif %}

        const sourcePath = fileURLToPath(new URL("../../", import.meta.url));
        const source = Source.asset(sourcePath, {
            exclude: ["cdk"],
            bundling: {
                image: DockerImage.fromRegistry("public.ecr.aws/docker/library/alpine:latest"),
                command: ["sh", "-c", 'echo "Docker build not supported." && exit 1'],
                local: {
                    tryBundle: (outputDir: string): boolean => {
                        execSync("pnpm build", {
                            stdio: ["ignore", process.stderr, process.stdout],
                            cwd: sourcePath,
                            env: {
                                ...process.env,
                                ...props.buildEnv,
                            },
                        });

                        copySync(path.join(sourcePath, "dist"), outputDir);

                        return true;
                    },
                },
                environment: props.buildEnv,
            },
            assetHashType: AssetHashType.OUTPUT,
        });

        {% if features contains "cognito" -%}
        const mutableFiles = [
            "index.html",
            "favicon.ico",
            "manifest.webmanifest",
            "config.json",
        ];
        {%- else -%}
        const mutableFiles = ["index.html", "favicon.ico", "manifest.webmanifest"];
        {%- endif %}

        const deploymentLogGroup = new LogGroup(this, "DeploymentLogGroup", {
            retention: RetentionDays.ONE_WEEK,
        });

        new BucketDeployment(this, "BucketDeployment", {
            destinationBucket: websiteBucket,
            logGroup: deploymentLogGroup,
            prune: false,
            exclude: mutableFiles,
            cacheControl: [CacheControl.fromString("max-age=31536000,public,immutable")],
            sources: [source],
            memoryLimit: 1024,
        });

        new BucketDeployment(this, "HtmlBucketDeployment", {
            destinationBucket: websiteBucket,
            logGroup: deploymentLogGroup,
            prune: false,
            exclude: ["*"],
            include: mutableFiles,
            cacheControl: [CacheControl.fromString("max-age=0,no-cache,no-store,must-revalidate")],
            {%- if features contains "cognito" %}
            // The Cognito IDs are only known at deploy time, so they are written as a runtime config
            // rather than baked into the build.
            sources: [source, Source.jsonData("config.json", cognitoAuth.runtimeConfig)],
            {%- else %}
            sources: [source],
            {%- endif %}
            memoryLimit: 1024,
        });
    }
}
