import { App } from "aws-cdk-lib";
import { AppStack } from "./app-stack.js";

const app = new App();

new AppStack(app, "{{project.name}}-staging", {
    env: {
        account: "{{awsEnv.accountId}}",
        region: "{{awsEnv.region}}",
    },
    certificateArn: "{{stagingDomain.certificateArn}}",
    domainName: "{{stagingDomain.domainName}}",
    buildEnv: {
        VITE_APP_API_ENDPOINT: "",
        {%- if features contains "auth0" %}
        VITE_APP_AUTH0_DOMAIN: "",
        VITE_APP_AUTH0_CLIENT_ID: "",
        VITE_APP_AUTH0_AUDIENCE: "",
        {%- endif %}
        {%- if sentry %}
        VITE_APP_SENTRY_DSN: "{{sentry.dsn}}",
        VITE_APP_SENTRY_ENVIRONMENT: "staging",
        VITE_APP_SENTRY_TRACES_SAMPLE_RATE: "0",
        {%- endif %}
    },
    {%- if features contains "cognito" %}
    cognito: {
        domainPrefix: "{{cognitoSettings.domainPrefix}}-staging",
        // The address, or its domain via `verifiedDomain`, must be verified in SES first.
        // ses: { fromEmail: "no-reply@example.com", fromName: "{{project.title}}" },
        allowLocalhost: true,
    },
    {%- endif %}
});

app.synth();
