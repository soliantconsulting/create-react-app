{%- if sentry %}
import { sentryVitePlugin } from "@sentry/vite-plugin";
{%- endif %}
import react from "@vitejs/plugin-react";
import { visualizer } from "rollup-plugin-visualizer";
import { defineConfig } from "vite";
import favicons from "vite-plugin-hashed-favicons";
import TanStackRouterVite from "@tanstack/router-plugin/vite";

export default defineConfig({
    plugins: [
        TanStackRouterVite({
            target: "react",
            autoCodeSplitting: true,
            routeFileIgnorePrefix: "-",
            quoteStyle: "double",
            semicolons: true,
            addExtensions: "js",
            customScaffolding: {
                routeTemplate: [
                    '%%tsrImports%%',
                    'import type { ReactNode } from "react";\n\n',
                    'const Root = (): ReactNode => "Hello %%tsrPath%%!";\n\n',
                    '%%tsrExportStart%%{\n component: Root\n }%%tsrExportEnd%%'
                ].join("\n"),
            },
        }),
        react(),
        visualizer(),
        favicons("./src/assets/favicon.svg"),
        {%- if sentry %}
        sentryVitePlugin({
            org: "{{sentry.org}}",
            project: "{{sentry.projectSlug}}",
            disable: !process.env.SENTRY_AUTH_TOKEN,
            telemetry: false,
            // Fail the build instead of silently deploying without source
            // maps (the upload failure would otherwise still delete them).
            errorHandler: (error) => {
                throw error;
            },
            release: {
                name: process.env.BITBUCKET_COMMIT,
            },
            sourcemaps: {
                // Source maps live in Sentry only; keep them out of the
                // public bucket.
                filesToDeleteAfterUpload: "./dist/**/*.map",
            },
        }),
        {%- endif %}
    ],
    resolve: {
        tsconfigPaths: true,
    },
    build: {
        {%- if sentry %}
        // Emit maps only when they can be uploaded to Sentry; without the
        // token the plugin self-disables, which would also skip the
        // delete-after-upload step and ship the maps to the public bucket.
        sourcemap: process.env.SENTRY_AUTH_TOKEN ? "hidden" : false,
        {%- else %}
        sourcemap: true,
        {%- endif %}
        rolldownOptions: {
            output: {
                codeSplitting: {
                    groups: [
                        {
                            name: "react",
                            test: /node_modules[\\/](react|react-dom|@tanstack[\\/]react-router)[\\/]/,
                        },
                        {
                            name: "mui",
                            test: /node_modules[\\/](@mui|material-ui-confirm|material-ui-popup-state|@emotion|notistack)/,
                        },
                        {
                            name: "query",
                            test: /node_modules[\\/](@tanstack[\\/]react-query|@jsonapi-serde)/,
                        },
                        {
                            name: "form",
                            test: /node_modules[\\/](react-hook-form|@hookform|mui-rhf-integration)/,
                        },
                        {
                            name: "zod",
                            test: /node_modules[\\/]zod/,
                        },
                        {%- if features contains "auth0" %}
                        {
                            name: "auth",
                            test: /node_modules[\\/]@auth0/,
                        },
                        {%- endif %}
                    ],
                },
            },
        },
    },
    server: {
        port: 3010,
    },
});

