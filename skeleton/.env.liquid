VITE_APP_API_ENDPOINT=http://localhost:3000
{%- if sentry %}

# Leave the DSN empty to disable Sentry in local development.
VITE_APP_SENTRY_DSN=
VITE_APP_SENTRY_ENVIRONMENT=development
VITE_APP_SENTRY_TRACES_SAMPLE_RATE=0
{%- endif %}
{%- if features contains "auth0" %}

VITE_APP_AUTH0_DOMAIN=
VITE_APP_AUTH0_CLIENT_ID=
VITE_APP_AUTH0_AUDIENCE=
{% endif %}
{%- if features contains "cognito" %}

# Local development only. Copy these from the staging stack outputs (see README).
# Deployed builds load them from /config.json instead.
VITE_APP_COGNITO_REGION={{awsEnv.region}}
VITE_APP_COGNITO_USER_POOL_ID=
VITE_APP_COGNITO_CLIENT_ID=
VITE_APP_COGNITO_DOMAIN=
{%- if features contains "cognito-admin" %}
VITE_APP_COGNITO_IDENTITY_POOL_ID=
{%- endif %}
{% endif %}
