import { ErrorCard } from "#/components/ErrorCard.js";
import { FullPageSpinner } from "#/components/FullPageSpinner.js";
import type { QueryOptionsFactory } from "#/queries/index.js";
import { AppBar, Box, Container, Toolbar, Typography } from "@mui/material";
{%- if sentry %}
import * as Sentry from "@sentry/react";
{%- endif %}
import type { QueryClient } from "@tanstack/react-query";
import { Outlet, createRootRouteWithContext } from "@tanstack/react-router";
{%- if sentry %}
import { type ReactNode, useEffect } from "react";
{%- else %}
import type { ReactNode } from "react";
{%- endif %}

export type RootRouterContext = {
    queryClient: QueryClient;
    qof: QueryOptionsFactory;
};

const Root = (): ReactNode => {
    return (
        <>
            <AppBar position="static">
                <Toolbar>
                    <Typography variant="h6" component="div">
                        {{project.title}}
                    </Typography>
                </Toolbar>
            </AppBar>
            <Box component="main" sx={{ '{{' }} py: 2 }}>
                <Outlet />
            </Box>
        </>
    );
};

type RootErrorProps = {
    error: Error;
};

const RootError = ({ error }: RootErrorProps): ReactNode => {
    {%- if sentry %}
    useEffect(() => {
        Sentry.captureException(error);
    }, [error]);
{% endif %}
    return (
        <Container maxWidth="md" sx={{ '{{' }} my: 2 }}>
            <ErrorCard error={error} />
        </Container>
    );
};

export const Route = createRootRouteWithContext<RootRouterContext>()({
    component: Root,
    pendingComponent: FullPageSpinner,
    errorComponent: RootError,
});
