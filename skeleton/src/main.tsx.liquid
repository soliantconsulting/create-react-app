{%- if features contains "auth0" -%}
import { Auth0Provider } from "@auth0/auth0-react";
import { AuthGuard } from "#/components/AuthGuard/index.js";
import { useAuthenticatedFetch } from "#/hooks/useAuthenticatedFetch.js";
{%- endif %}
{%- if features contains "cognito" -%}
import { AuthGuard } from "#/components/AuthGuard/index.js";
import { useAuthenticatedFetch } from "#/hooks/useAuthenticatedFetch.js";
import { getAuthority, getConfig } from "#/utils/config.js";
import { WebStorageStateStore } from "oidc-client-ts";
import { AuthProvider } from "react-oidc-context";
{%- endif %}
{%- if features contains "cognito-admin" %}
import {
    CognitoAdminClientProvider,
    useCognitoAdminClient,
} from "#/cognito/CognitoAdminClient.js";
import { useIsAdmin } from "#/hooks/useIsAdmin.js";
{%- endif %}
import { InlineSpinner } from "#/components/InlineSpinner.js";
import { MultiProvider } from "#/components/MultiProvider.js";
import "@fontsource/roboto/300.css";
import "@fontsource/roboto/400.css";
import "@fontsource/roboto/500.css";
import "@fontsource/roboto/700.css";
import {
    type QueryOptionsFactory,
    QueryOptionsFactoryProvider,
    createQueryOptionsFactory,
} from "#/queries/index.js";
import { routeTree } from "#/routeTree.gen.js";
import { extendedReplaceEqualDeep } from "#/utils/api.js";
import { CssBaseline, createTheme } from "@mui/material";
{%- if sentry %}
import * as Sentry from "@sentry/react";
{%- endif %}
import { ThemeProvider } from "@mui/material/styles";
import { QueryClient, QueryClientProvider } from "@tanstack/react-query";
import { RouterProvider, createRouter } from "@tanstack/react-router";
import { SnackbarProvider } from "notistack";
import { type ReactNode, StrictMode } from "react";
import { ConfirmProvider } from "material-ui-confirm";
import { createRoot } from "react-dom/client";

const container = document.getElementById("root");

if (!container) {
    throw new Error("Root element missing");
}

const queryClient = new QueryClient({
    defaultOptions: {
        queries: {
            structuralSharing: extendedReplaceEqualDeep,
            retry: false,
        },
    },
});

{%- if sentry %}
const root = createRoot(container, {
    onUncaughtError: Sentry.reactErrorHandler(),
    onCaughtError: Sentry.reactErrorHandler(),
    onRecoverableError: Sentry.reactErrorHandler(),
});
{%- else %}
const root = createRoot(container);
{%- endif %}

const router = createRouter({
    routeTree,
    defaultPendingComponent: InlineSpinner,
    context: {
        queryClient,
        // Injected through React
        qof: undefined as unknown as QueryOptionsFactory,
        {%- if features contains "cognito-admin" %}
        isAdmin: false,
        {%- endif %}
    },
    defaultPreload: "intent",
    defaultPreloadStaleTime: 0,
});

declare module "@tanstack/react-router" {
    interface Register {
        router: typeof router;
    }
}

{%- if features contains "cognito" %}

const cognitoConfig = getConfig();
const userStore = new WebStorageStateStore({ store: window.localStorage });
{%- endif %}

const App = (): ReactNode => {
    {%- if features contains "auth0" or features contains "cognito" %}
    const authFetch = useAuthenticatedFetch();
    {%- else %}
    const authFetch = fetch;
    {%- endif %}
    {%- if features contains "cognito-admin" %}
    const cognitoAdminClient = useCognitoAdminClient();
    const isAdmin = useIsAdmin();
    const queryOptionsFactory = createQueryOptionsFactory(authFetch, cognitoAdminClient);
    {%- else %}
    const queryOptionsFactory = createQueryOptionsFactory(authFetch);
    {%- endif %}

    return (
        <QueryOptionsFactoryProvider factory={queryOptionsFactory}>
            <RouterProvider
                router={router}
                context={{ '{{' }}
                    qof: queryOptionsFactory,
                    {%- if features contains "cognito-admin" %}
                    isAdmin,
                    {%- endif %}
                }}
            />
        </QueryOptionsFactoryProvider>
    );
};

const theme = createTheme();

root.render(
    <StrictMode>
        <MultiProvider
            providerCreators={[
                (children) => (
                    <ThemeProvider theme={theme}>
                        <CssBaseline />
                        {children}
                    </ThemeProvider>
                ),
                (children) => (
                    <QueryClientProvider client={queryClient}>{children}</QueryClientProvider>
                ),
                {%- if features contains "auth0" %}
                (children) => (
                    <Auth0Provider
                        domain={import.meta.env.VITE_APP_AUTH0_DOMAIN}
                        clientId={import.meta.env.VITE_APP_AUTH0_CLIENT_ID}
                        authorizationParams={{ '{{' }}
                            redirect_uri: window.location.origin,
                            audience: import.meta.env.VITE_APP_AUTH0_AUDIENCE,
                        }}
                        onRedirectCallback={(appState) => {
                            void router.navigate({to: appState?.returnTo ?? "/"});
                        }}
                        useRefreshTokens
                        cacheLocation="localstorage"
                    >
                        {children}
                    </Auth0Provider>
                ),
                (children) => <AuthGuard>{children}</AuthGuard>,
                {%- endif %}
                {%- if features contains "cognito" %}
                (children) => (
                    <AuthProvider
                        authority={getAuthority()}
                        client_id={cognitoConfig.clientId}
                        redirect_uri={window.location.origin}
                        scope={cognitoConfig.scope}
                        metadataSeed={{ '{{' }}
                            revocation_endpoint: new URL("/oauth2/revoke", cognitoConfig.domain)
                                .href,
                        }}
                        userStore={userStore}
                        onSigninCallback={(user) => {
                            const state = user?.state as { returnTo?: string } | undefined;
                            // Replaces the URL, which also drops the ?code=…&state=… parameters.
                            router.history.replace(state?.returnTo ?? "/");
                        }}
                    >
                        {children}
                    </AuthProvider>
                ),
                (children) => <AuthGuard>{children}</AuthGuard>,
                {%- endif %}
                {%- if features contains "cognito-admin" %}
                (children) => <CognitoAdminClientProvider>{children}</CognitoAdminClientProvider>,
                {%- endif %}
                (children) => <SnackbarProvider>{children}</SnackbarProvider>,
                (children) => <ConfirmProvider>{children}</ConfirmProvider>,
            ]}
        >
            <App />
        </MultiProvider>
    </StrictMode>,
);
